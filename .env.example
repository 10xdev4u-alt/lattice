# Lattice env vars — copy to .env.local for local dev.
# Never commit the populated .env.local file.

# LLM endpoint (OpenAI-compatible). Default in code; override here.
LATTICE_LLM_BASE=https://api.kilo.ai/api/gateway/v1
LATTICE_LLM_MODEL=poolside-laguna-free
LATTICE_LLM_KEY=latticex

# Magic-link auth (lands with the auth sprint)
# AUTH_EMAIL_FROM=lattice@example.com
# AUTH_EMAIL_PROVIDER=resend
# AUTH_RESEND_KEY=

# Session secret (lands with the auth sprint)
# SESSION_SECRET=change-me
